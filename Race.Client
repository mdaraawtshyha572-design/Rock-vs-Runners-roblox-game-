-- ╔═══════════════════════════════════════════════════════════════════╗
-- ║   🖼️  كاش صور الأفاتار                                         ║
-- ╚═══════════════════════════════════════════════════════════════════╝

local avatarCache = {}  -- { [userId] = "rbxthumb://..." }

local function getAvatarUrl(userId)
	if avatarCache[userId] then
		return avatarCache[userId]
	end

	local ok, img = pcall(function()
		return Players:GetUserThumbnailAsync(
			userId,
			Enum.ThumbnailType.HeadShot,
			Enum.ThumbnailSize.Size420x420
		)
	end)

	if ok and img and img ~= "" then
		avatarCache[userId] = img
		return img
	end

	return nil
end

-- ✅ نحمّل صور كل اللاعبين الموجودين من البداية (في الخلفية)
task.spawn(function()
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			getAvatarUrl(player.UserId)
		end)
	end
end)

-- ✅ لما لاعب جديد يدخل، نحمّل صورته بالخلفية
Players.PlayerAdded:Connect(function(player)
	task.spawn(function()
		getAvatarUrl(player.UserId)
	end)
end)


local function getAligned(alignment, paddingX, posY)
	local anchorX, posX
	if alignment == "Right" then
		anchorX = 1;   posX = 1 - paddingX
	elseif alignment == "Center" then
		anchorX = 0.5; posX = 0.5
	else
		anchorX = 0;   posX = paddingX
	end
	return Vector2.new(anchorX, 0), UDim2.new(posX, 0, posY, 0)
end

local function addStroke(parent, color, thickness, mode)
	local s = Instance.new("UIStroke")
	s.Color        = color or CONFIG.StrokeColor
	s.Thickness    = thickness or CONFIG.StrokeThickness
	s.Transparency = 0
	if mode then s.ApplyStrokeMode = mode end
	s.Parent       = parent
	return s
end

local function addTextStroke(lbl, color, thickness)
	return addStroke(lbl, color or CONFIG.StrokeColor, thickness or CONFIG.StrokeThickness)
end

local function playGameSound(soundName)
	local sd = CONFIG.Sounds[soundName]
	if not sd then return end
	local s = Instance.new("Sound")
	s.SoundId = sd.Id
	s.Volume  = sd.Volume
	s.Parent  = SoundService
	s:Play()
	s.Ended:Connect(function() s:Destroy() end)
end


