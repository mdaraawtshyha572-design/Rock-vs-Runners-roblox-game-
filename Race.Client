-- ╔═══════════════════════════════════════════════════════════════════╗
-- ║   🔄  نظام التايمر + الرسائل التحفيزية                         ║
-- ╚═══════════════════════════════════════════════════════════════════╝

local myTeam             = nil
local currentTimerSeconds = 0
local isTimerActive      = false
local isShowingHint      = false
local hintToken          = 0
local hintMessageIndex   = 0

local function formatTime(seconds)
	return string.format("⏱ %d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function displayTimer()
	if not isTimerActive or isShowingHint then return end
	statusText.Text       = formatTime(currentTimerSeconds)
	statusText.TextColor3 = currentTimerSeconds <= sb.WarningThreshold and sb.WarningColor or CONFIG.TextColor
	TweenService:Create(statusBar, TweenInfo.new(0.3), {
		BackgroundColor3 = currentTimerSeconds <= sb.FlashThreshold and sb.FlashBgColor or sb.BgColor
	}):Play()
end

local function showHintMessage()
	if not sb.HintsEnabled or not isTimerActive then return end
	if #sb.HintMessages == 0 then return end
	isShowingHint = true
	hintMessageIndex = (hintMessageIndex % #sb.HintMessages) + 1
	local msg = sb.HintMessages[hintMessageIndex]
	TweenService:Create(statusText, TweenInfo.new(sb.HintFadeTime), { TextTransparency = 1 }):Play()
	task.delay(sb.HintFadeTime, function()
		if not isTimerActive then isShowingHint = false return end
		statusText.Text       = msg
		statusText.TextColor3 = CONFIG.TextColor
		TweenService:Create(statusText, TweenInfo.new(sb.HintFadeTime), { TextTransparency = 0 }):Play()
		task.delay(sb.HintDuration, function()
			if not isTimerActive then isShowingHint = false return end
			TweenService:Create(statusText, TweenInfo.new(sb.HintFadeTime), { TextTransparency = 1 }):Play()
			task.delay(sb.HintFadeTime, function()
				isShowingHint = false
				if not isTimerActive then return end
				displayTimer()
				TweenService:Create(statusText, TweenInfo.new(sb.HintFadeTime), { TextTransparency = 0 }):Play()
			end)
		end)
	end)
end

local function startHintLoop()
	if not sb.HintsEnabled then return end
	hintToken += 1
	local myToken = hintToken
	hintMessageIndex = 0
	task.spawn(function()
		while isTimerActive and hintToken == myToken do
			task.wait(sb.HintInterval)
			if not isTimerActive or hintToken ~= myToken then return end
			showHintMessage()
		end
	end)
end

local function stopHintLoop()
	hintToken += 1
	isShowingHint = false
end


-- ╔═══════════════════════════════════════════════════════════════════╗
-- ║   🎮  دوال الـ UI                                               ║
-- ╚═══════════════════════════════════════════════════════════════════╝

local function updateStatusText(text)
	stopHintLoop()
	isShowingHint = false
	statusText.TextTransparency = 0
	statusText.Text             = text
	statusText.TextColor3       = CONFIG.TextColor
	statusBar.BackgroundColor3  = sb.BgColor
end

local function updateTimerDisplay(seconds)
	currentTimerSeconds = seconds
	isTimerActive = true
	if not isShowingHint then displayTimer() end
end

local function showCountdown(text)
	if not cd.Visible then return end
	countdownLabel.Text             = text
	countdownLabel.TextTransparency = 1
	countdownStroke.Transparency    = 1
	countdownLabel.Visible          = true
	countdownLabel.TextColor3       = (text == "GO!") and cd.GoColor or CONFIG.TextColor
	local origSize = UDim2.new(cd.Width, 0, cd.Height, 0)
	countdownLabel.Size = UDim2.new(cd.Width * 0.5, 0, cd.Height * 0.5, 0)
	TweenService:Create(countdownLabel, TweenInfo.new(cd.FadeInTime, Enum.EasingStyle.Back), {
		TextTransparency = 0, Size = origSize
	}):Play()
	TweenService:Create(countdownStroke, TweenInfo.new(cd.FadeInTime), { Transparency = 0 }):Play()
	task.delay(cd.DisplayDuration, function()
		TweenService:Create(countdownLabel, TweenInfo.new(cd.FadeOutTime), { TextTransparency = 1 }):Play()
		TweenService:Create(countdownStroke, TweenInfo.new(cd.FadeOutTime), { Transparency = 1 }):Play()
		task.delay(cd.FadeOutTime + 0.05, function() countdownLabel.Visible = false end)
	end)
end

-- ╔═══════════════════════════════════════════════════════════════════╗
-- ║   ✅ إصلاح showWinnerUI — الصورة تتحمّل قبل ما يطلع الفريم    ║
-- ╚═══════════════════════════════════════════════════════════════════╝

local function showWinnerUI(winnerNameText, winnerUserId, winnerTeam)
	if not wn.Visible then return end

	isTimerActive = false
	stopHintLoop()

	local isRock    = (winnerTeam == "Rock")
	local teamColor = isRock and wn.RockWinColor or wn.RunnerWinColor

	winnerTitle.Text       = isRock and wn.RockText or wn.RunnerText
	winnerTitle.TextColor3 = teamColor
	winnerStroke.Color     = teamColor

	winnerName.Text             = winnerNameText
	winnerTeamLabel.Text        = isRock and wn.RockTeamText or wn.RunnerTeamText
	winnerTeamLabel.TextColor3  = isRock and wn.RockTeamColor or wn.RunnerTeamColor

	-- ✅ الإصلاح الرئيسي: نحمّل الصورة أولاً من الكاش أو السيرفر
	avatarImg.Image = ""
	avatarImg.BackgroundColor3 = wn.AvatarBgColor

	if winnerUserId and winnerUserId > 0 then
		-- نجيب الصورة (من الكاش لو موجودة = فوري، أو نحمّلها)
		local cachedImg = getAvatarUrl(winnerUserId)
		if cachedImg then
			avatarImg.Image = cachedImg
			avatarImg.BackgroundTransparency = 0
		else
			avatarImg.BackgroundColor3 = isRock and wn.RockFallbackColor or wn.RunnerFallbackColor
		end
	else
		avatarImg.BackgroundColor3 = isRock and wn.RockFallbackColor or wn.RunnerFallbackColor
	end

	-- إشعار "فريقك يفوز"
	if myTeam == winnerTeam and yw.Visible then
		youWinFrame.BackgroundColor3     = teamColor
		youWinFrame.Visible              = true
		youWinFrame.BackgroundTransparency = 1
		TweenService:Create(youWinFrame, TweenInfo.new(yw.FadeInTime, Enum.EasingStyle.Back), {
			BackgroundTransparency = yw.BgTransparency
		}):Play()
		task.delay(yw.ShowDuration, function()
			TweenService:Create(youWinFrame, TweenInfo.new(yw.FadeOutTime), { BackgroundTransparency = 1 }):Play()
			task.delay(yw.FadeOutTime + 0.05, function() youWinFrame.Visible = false end)
		end)
	end

	-- أنيميشن الفائز (الحين الصورة جاهزة قبل ما يطلع)
	winnerFrame.Position = UDim2.new(0.5, 0, wn.PosY + wn.OffsetY, 0)
	winnerFrame.Visible  = true
	TweenService:Create(winnerFrame, TweenInfo.new(wn.AnimInTime, Enum.EasingStyle.Back), {
		Position = UDim2.new(0.5, 0, wn.PosY, 0)
	}):Play()
	task.delay(wn.ShowDuration, function()
		TweenService:Create(winnerFrame, TweenInfo.new(wn.AnimOutTime, Enum.EasingStyle.Quad), {
			Position = UDim2.new(0.5, 0, wn.PosY - wn.OffsetY, 0)
		}):Play()
		task.delay(wn.AnimOutTime + 0.05, function() winnerFrame.Visible = false end)
	end)
end


-- ╔═══════════════════════════════════════════════════════════════════╗
-- ║   📡  استقبال الأحداث                                           ║
-- ╚═══════════════════════════════════════════════════════════════════╝

UpdateTeamCount.OnClientEvent:Connect(function(rockCount, runnerCount)
	rockLabel.Text   = tc.RockEmoji .. " Rocks: " .. rockCount
	runnerLabel.Text = tc.RunnerEmoji .. " Runners: " .. runnerCount
end)

AssignTeam.OnClientEvent:Connect(function(team) myTeam = team end)
UpdateStatus.OnClientEvent:Connect(updateStatusText)
StartCountdown.OnClientEvent:Connect(showCountdown)
ShowWinner.OnClientEvent:Connect(function(n, id, t) showWinnerUI(n, id, t) end)

local hintStarted = false
UpdateTimer.OnClientEvent:Connect(function(seconds)
	updateTimerDisplay(seconds)
	if seconds > 0 then
		if not hintStarted then
			hintStarted = true
			startHintLoop()
		end
	else
		hintStarted = false
		isTimerActive = false
		stopHintLoop()
	end
end)


task.spawn(function()
	task.wait(1)
	local ok, state = pcall(function() return SyncRaceState:InvokeServer() end)
	if ok and state then
		updateStatusText(state.currentStatus)
		if state.raceTimer and state.raceTimer > 0 then
			updateTimerDisplay(state.raceTimer)
			startHintLoop()
		end
	end
end)

PlaySound.OnClientEvent:Connect(function(soundName)
	playGameSound(soundName)
end)


local isInKickOff       = false
local originalJumpPower = 50

KickOffState.OnClientEvent:Connect(function(state)
	isInKickOff = state
	local char = localPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			if isInKickOff then
				hum.JumpPower  = 0
				hum.JumpHeight = 0
			else
				hum.JumpPower  = originalJumpPower
				hum.JumpHeight = 7.2
			end
		end
	end
end)


print("[RaceUI] v3 Avatar Preload + Cache Ready!")
